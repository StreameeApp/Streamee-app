{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamee-tmdb",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    {
      "name": "TMDB_RATE_LIMITER",
      "namespace_id": "26082601",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05
  }
}
