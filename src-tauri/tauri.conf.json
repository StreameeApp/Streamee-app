{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Streamee",
    "version":  "2.0.1",
    "identifier":  "com.streamee.app.v2",
    "build":  {
                  "devUrl":  "http://localhost:5173",
                  "frontendDist":  "../dist",
                  "beforeDevCommand":  "npm run clean:mpv \u0026\u0026 npm run dev",
                  "beforeBuildCommand":  "npm run clean:mpv \u0026\u0026 npm run build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Streamee",
                                    "width":  1600,
                                    "height":  900,
                                    "minWidth":  800,
                                    "minHeight":  600,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "transparent":  false,
                                    "decorations":  true,
                                    "center":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "icon":  [
                                "icons/icon.ico"
                            ],
                   "targets":  [
                                   "msi"
                               ],
                   "resources":  {
                                     "../mpv/":  "mpv/",
                                     "../node_modules/":  "node_modules/",
                                     "target/node-runtime/streameenode.exe":  "streameenode.exe",
                                     "src/webtorrent-server.cjs":  "webtorrent-server.cjs",
                                     "resources/fpcalc.exe":  "fpcalc.exe",
                                     "resources/CHROMAPRINT-LICENSE.md":  "CHROMAPRINT-LICENSE.md",
                                     "resources/LGPL-2.1.txt":  "LGPL-2.1.txt"
                                 },
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser"
                                            }
                               }
               },
    "plugins":  {
                    "shell":  {
                                  "open":  true
                              }
                }
}
